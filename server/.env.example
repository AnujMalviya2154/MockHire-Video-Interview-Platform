# Copy this file to .env and fill in real values. NEVER commit .env to git.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/interview_platform
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Server-only Cloudflare TURN configuration.
# Never expose these through VITE_* or client-side configuration.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
