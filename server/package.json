{
  "name": "interview-platform-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; import('./src/index.js')\"",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/m2-interviews.test.mjs && node tests/m3-signaling.test.mjs && node tests/m6c-startup.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
